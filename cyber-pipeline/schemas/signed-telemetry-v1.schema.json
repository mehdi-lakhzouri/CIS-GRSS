    "TelemetryMessage": {
      "additionalProperties": false,
      "description": "One sensor observation. Sequence starts at 1 for each sensor/session pair.",
      "oneOf": [
        {
          "properties": {
            "sensor_id": {
              "const": "uscrn-az-tucson-11-w"
            },
            "station": {
              "const": "AZ_Tucson_11_W"
            }
          }
        },
        {
