      ],
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sensor_id": {
          "title": "Sensor Id",
          "type": "string"
        },
        "station": {
          "title": "Station",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "observation_time": {
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00(?:\\.0+)?(?:Z|\\+00:00)$",
          "title": "Observation Time",
          "type": "string"
        },
        "sent_at": {
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|\\+00:00)$",
          "title": "Sent At",
          "type": "string"
        },
        "measurements": {
          "$ref": "#/$defs/Measurements"
        }
      },
      "required": [
        "schema_version",
        "sensor_id",
        "station",
        "session_id",
        "sequence",
        "observation_time",
        "sent_at",
